# ============================================
# VARIABLES DE ENTORNO — PRODUCCIÓN
# ============================================
# Copia este archivo y configura los valores reales
# en Vercel (frontend) y Railway (backend).
# ============================================

# ─── BASE DE DATOS (Railway/Supabase) ───
# Obtén esto de tu proyecto en Supabase → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── JWT ───
# IMPORTANTE: Genera un secret fuerte (mínimo 32 caracteres)
# Puedes usar: openssl rand -base64 32
JWT_SECRET=CAMBIAR-POR-UN-SECRET-FUERTE-DE-32-CHARS-MINIMO
JWT_EXPIRES_IN=7d

# ─── SERVIDOR ───
API_PORT=4000
# URL del frontend para CORS (separar múltiples con coma)
FRONTEND_URL=https://tu-app.vercel.app

# ─── CLOUDINARY (Upload de imágenes) ───
# Crear cuenta gratis en https://cloudinary.com
# Dashboard → Account Details
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ─── FRONTEND (Variables NEXT_PUBLIC_*) ───
# Estas van en Vercel → Project Settings → Environment Variables
NEXT_PUBLIC_API_URL=https://tu-api.railway.app
NEXT_PUBLIC_WS_URL=https://tu-api.railway.app
NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola! Quiero hacer un pedido

# ============================================
# RESUMEN: DÓNDE VA CADA VARIABLE
# ============================================
# 
# RAILWAY (Backend):
#   - DATABASE_URL
#   - JWT_SECRET
#   - JWT_EXPIRES_IN
#   - API_PORT
#   - FRONTEND_URL
#   - CLOUDINARY_CLOUD_NAME
#   - CLOUDINARY_API_KEY
#   - CLOUDINARY_API_SECRET
#
# VERCEL (Frontend):
#   - NEXT_PUBLIC_API_URL
#   - NEXT_PUBLIC_WS_URL
#   - NEXT_PUBLIC_WHATSAPP_NUMBER
#   - NEXT_PUBLIC_WHATSAPP_MESSAGE
#
# ============================================
