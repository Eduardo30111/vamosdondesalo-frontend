generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { ADMIN VENDEDOR COCINA }
enum OrderType { TABLE TAKEAWAY DELIVERY }
enum OrderStatus { PENDING PREPARING READY DELIVERED PAID }
enum PreparationMode { VITRINA PREPARADO }

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()"))
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now())
}

model Product {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  name            String
  description     String?
  photoUrl        String?
  salePrice       Float
  costPrice       Float
  type            String           // SUPPLIER OWN
  preparationMode PreparationMode  @default(VITRINA)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())
}

model VitrinaStock {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  productId String   @unique
  qty       Int      @default(0)
}

model ProductionOrder {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  productId    String
  requestedQty Int
  readyQty     Int      @default(0)
  userId       String
  createdAt    DateTime @default(now())
}

model Table {
  id       String  @id @default(dbgenerated("gen_random_uuid()"))
  number   Int     @unique
  qrToken  String  @unique @default(dbgenerated("gen_random_uuid()"))
}

model DeliveryZone {
  id      String  @id @default(dbgenerated("gen_random_uuid()"))
  name    String
  fee     Float
  enabled Boolean @default(true)
}

model Order {
  id              String       @id @default(dbgenerated("gen_random_uuid()"))
  type            OrderType
  trackingCode    String?      @unique
  tableId         String?
  customerName    String
  customerPhone   String?
  customerAddress String?
  deliveryZoneId  String?
  deliveryFee     Float        @default(0)
  status          OrderStatus  @default(PAID)
  notes           String?
  total           Float
  createdAt       DateTime     @default(now())
}

model OrderItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  orderId   String
  productId String
  qty       Int
  unitPrice Float
  notes     String?
  isPrep    Boolean  @default(false)
}

model Payment {
  id       String   @id @default(dbgenerated("gen_random_uuid()"))
  orderId  String
  method   String
  amount   Float
  createdAt DateTime @default(now())
}

model PaymentMethodConfig {
  method  String  @id
  qrUrl   String?
  key     String?
  enabled Boolean @default(true)
}

model AppConfig {
  key   String @id
  value String
}

model Customer {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  name       String
  cedula     String   @unique
  phone      String?
  totalDebt  Float    @default(0)
}

model Credit {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  customerId String
  amount     Float
  type       String
  createdAt  DateTime @default(now())
}

model Expense {
  id       String   @id @default(dbgenerated("gen_random_uuid()"))
  category String
  amount   Float
  type     String
  date     DateTime @default(now())
}

model CashClose {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  date         DateTime
  expectedCash Float
  actualCash   Float
  difference   Float
}

model DailyStock {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  date      DateTime @db.Date
  productId String
  initialQty Int
  userId     String
  @@unique([date, productId])
}

model Waste {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  productId String
  qty       Int
  reason    String
  createdAt DateTime @default(now())
}
