generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VENDEDOR
  COCINA
}

enum ProductType {
  OWN
  SUPPLIER
}

enum OrderType {
  TABLE
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  IN_TRANSIT
  DELIVERED
  PAID
}

enum PaymentMethod {
  CASH
  NEQUI
  BANCOLOMBIA
  DAVIPLATA
  TRANSFER
}

enum CreditType {
  CHARGE
  PAYMENT
}

enum WasteReason {
  DAMAGED
  GIFTED
  LOST
  OTHER
}

enum ExpenseType {
  DAILY
  MONTHLY
}

enum KitchenProductionStatus {
  PREPARING
  READY
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  wastes       Waste[]
  expenses     Expense[]
  cashCloses   CashClose[]
}

model Supplier {
  id       String    @id @default(uuid())
  name     String
  phone    String?
  products Product[]
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  photoUrl    String?
  salePrice   Float
  costPrice   Float
  type        ProductType
  isPrepared  Boolean     @default(true)
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  dailyStock  Int         @default(50)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  wastes      Waste[]
  dailyStocks DailyStock[]
  kitchenProductions KitchenProduction[]
}

model Table {
  id      String  @id @default(uuid())
  number  Int     @unique
  qrToken String  @unique @default(uuid())
  orders  Order[]
}

model DeliveryZone {
  id      String  @id @default(uuid())
  name    String
  fee     Float
  enabled Boolean @default(true)
  orders  Order[]
}

model Order {
  id              String       @id @default(uuid())
  type            OrderType
  trackingCode    String?      @unique
  tableId         String?
  table           Table?       @relation(fields: [tableId], references: [id])
  customerName    String
  customerPhone   String?
  customerAddress String?
  deliveryZoneId  String?
  deliveryZone    DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  deliveryFee     Float        @default(0)
  status          OrderStatus  @default(PENDING)
  notes           String?
  total           Float        @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           OrderItem[]
  payments        Payment[]
  credits         Credit[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Float
  notes     String?
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Float
  proofUrl  String?
  confirmed Boolean       @default(false)
  createdAt DateTime      @default(now())
}

model PaymentMethodConfig {
  method  PaymentMethod @id
  qrUrl   String?
  key     String?
  enabled Boolean       @default(true)
}

// === Phase 2 Models ===

model Customer {
  id        String   @id @default(uuid())
  name      String
  cedula    String   @unique
  phone     String?
  totalDebt Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  credits   Credit[]
}

model Credit {
  id         String     @id @default(uuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?     @relation(fields: [orderId], references: [id])
  amount     Float
  type       CreditType
  note       String?
  createdAt  DateTime   @default(now())
}

model Waste {
  id        String      @id @default(uuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  qty       Int
  reason    WasteReason
  note      String?
  createdAt DateTime    @default(now())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
}

model Expense {
  id          String      @id @default(uuid())
  category    String
  description String
  amount      Float
  type        ExpenseType
  date        DateTime    @default(now())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  createdAt   DateTime    @default(now())
}

model CashClose {
  id           String   @id @default(uuid())
  date         DateTime
  expectedCash Float
  actualCash   Float
  difference   Float
  note         String?
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
}

model AppConfig {
  key   String @id
  value String
}

model DailyStock {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  initialQty  Int
  soldQty     Int      @default(0)
  remaining   Int

  @@unique([date, productId])
  @@index([date])
  @@index([productId])
}

model KitchenProduction {
  id         String                  @id @default(uuid())
  productId  String
  product    Product                 @relation(fields: [productId], references: [id])
  startedQty Int
  readyQty   Int                     @default(0)
  status     KitchenProductionStatus @default(PREPARING)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([productId])
  @@index([status])
}
