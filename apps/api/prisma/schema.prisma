generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VENDEDOR
  COCINA
  MERCHANT
  MERCHANT_STAFF
}

enum OrderType {
  TABLE
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  IN_TRANSIT
  DELIVERED
  PAID
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FIADO
  CANCELLED
}

enum PreparationMode {
  VITRINA
  PREPARADO
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preparedAuthorizations PreparedAuthorization[]
  wastes                 Waste[]
  cashCloses             CashClose[]

  storeId      String?
  store        Store?   @relation("StoreUsers", fields: [storeId], references: [id])
  ownedStore   Store?   @relation("StoreOwner")
}

model Product {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()"))
  name                  String
  description           String?
  photoUrl              String?
  salePrice             Float
  costPrice             Float
  type                  String                    // OWN | SUPPLIER
  preparationMode       PreparationMode           @default(VITRINA)
  active                Boolean                   @default(true)
  dailyStock            Int                       @default(0)
  saleType              String                    @default("UNIT")
  prices                String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  supplierId            String?
  supplierReceivedQty   Int                       @default(0)
  supplierReturnedQty   Int                       @default(0)
  supplier              Supplier?                 @relation(fields: [supplierId], references: [id])
  vitrinaStock          VitrinaStock?
  productionOrders      ProductionOrder[]
  orderItems            OrderItem[]
  wastes                Waste[]
  preparedAuthorizations PreparedAuthorization[]

  storeId               String?
  store                 Store?                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model VitrinaStock {
  id        String  @id @default(dbgenerated("gen_random_uuid()"))
  productId String  @unique
  qty       Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductionOrder {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  productId    String
  requestedQty Int
  readyQty     Int      @default(0)
  userId       String
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Table {
  id      String  @id @default(dbgenerated("gen_random_uuid()"))
  number  Int     @unique
  qrToken String  @unique @default(dbgenerated("gen_random_uuid()"))
  orders  Order[]
}

model DeliveryZone {
  id      String  @id @default(dbgenerated("gen_random_uuid()"))
  name    String
  fee     Float
  enabled Boolean @default(true)
  orders  Order[]
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()"))
  type            OrderType
  trackingCode    String?     @unique
  tableId         String?
  customerName    String
  customerPhone   String?
  customerAddress String?
  customerDoc     String?
  deliveryZoneId  String?
  deliveryFee     Float       @default(0)
  // fulfillmentStatus conserva los valores del enum OrderStatus existentes (PENDING->...->DELIVERED, etc)
  // Se mapea a la columna histórica `status` para evitar una migración destructiva.
  fulfillmentStatus OrderStatus @default(PAID) @map("status")
  paymentStatus     PaymentStatus @default(UNPAID)
  isFiated        Boolean     @default(false)
  notes           String?
  total           Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  table        Table?        @relation(fields: [tableId], references: [id])
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  items        OrderItem[]
  payments     Payment[]

  storeId      String?
  store        Store?        @relation(fields: [storeId], references: [id])
}

model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()"))
  orderId   String
  productId String
  qty       Int
  unitPrice Float
  notes     String?
  isPrep    Boolean @default(false)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  orderId   String
  method    String
  amount    Float
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AppConfig {
  key   String @id
  value String
}

model PaymentMethodConfig {
  method  String  @id
  qrUrl   String?
  key     String?
  enabled Boolean @default(true)
}

model Supplier {
  id       String    @id @default(dbgenerated("gen_random_uuid()"))
  name     String
  phone    String?
  products Product[]
}

model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  cedula    String   @unique
  phone     String?
  totalDebt Float    @default(0)
  credits   Credit[]
}

model Credit {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  customerId String
  amount     Float
  type       String
  note       String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Expense {
  id       String   @id @default(dbgenerated("gen_random_uuid()"))
  category String
  amount   Float
  type     String
  date     DateTime @default(now())
  userId   String?
}

model CashClose {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  date         DateTime
  expectedCash Float
  actualCash   Float
  difference   Float
  note         String?
  userId       String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
}

model Waste {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  productId String
  qty       Int
  reason    String
  note      String?
  userId    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model PreparedAuthorization {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  productId String
  userId    String?
  date      String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([productId, date])
  @@map("autorizar_preparados")
}

enum PlanType {
  FREE
  PRO
}

model Store {
  id              String      @id @default(dbgenerated("gen_random_uuid()"))
  name            String
  description     String?
  logoUrl         String?
  bannerUrl       String?
  active          Boolean     @default(true)
  whatsappNumber  String
  category        String      // RESTAURANT, TIENDA, ROPA, etc.
  plan            PlanType    @default(FREE)
  planExpiresAt   DateTime
  commissionRate  Float       @default(0.08)
  balance         Float       @default(0.0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  promoMedia      String?
  customTheme     String?
  customDomain    String?

  deliveryFeePuerto       Float    @default(2500)
  deliveryFeePradomar     Float    @default(3000)
  deliveryFeeSalgar       Float    @default(5000)
  deliveryFeeBarranquilla Float    @default(8000)

  ownerId         String      @unique
  owner           User        @relation("StoreOwner", fields: [ownerId], references: [id])

  users           User[]      @relation("StoreUsers")
  products        Product[]
  orders          Order[]
}
